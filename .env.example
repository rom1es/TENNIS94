# Port du serveur web de contrôle
PORT=3000

# Configuration du serveur SMTP de notification (ex : Free, Orange, Gmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-email@example.com
SMTP_PASS=votre-mot-de-passe
SMTP_FROM="Robot Padel <votre-email@example.com>"

# Emails des joueurs destinataires (séparés par des espaces ou virgules)
NOTIFICATION_EMAILS=joueur1@example.com joueur2@example.com

# (Facultatif) Chemin absolu vers le binaire Chromium du système (ex: /usr/bin/chromium)
# CHROMIUM_PATH=/usr/bin/chromium

# ==============================================================================
# Configuration d'authentification Keycloak (OAuth2 / OIDC)
# ==============================================================================
ENABLE_KEYCLOAK=true

# Mode d'exécution Keycloak :
# - 'local'  : En DEV, Keycloak tourne localement dans Docker (port 8080) avec PostgreSQL local.
# - 'remote' : En PROD, Keycloak est hébergé sur un autre serveur (ne sera PAS démarré sur cette machine).
# Si non défini, détection auto : passe en 'remote' si NODE_ENV=production ou si KC_DISCOVERY_URL est distant.
KEYCLOAK_MODE=local

# URL du document de découverte OIDC (.well-known/openid-configuration)
# En DEV (Docker local) : http://localhost:8080/realms/tennis94/.well-known/openid-configuration
# En PROD (Serveur externe) : https://auth.votre-domaine.com/realms/tennis94/.well-known/openid-configuration
KC_DISCOVERY_URL=http://localhost:8080/realms/tennis94/.well-known/openid-configuration

KC_CLIENT_ID=padel-dashboard
KC_CLIENT_SECRET=votre_secret_client_keycloak

# URL de callback après authentification
# En DEV : http://localhost:3000/auth/callback
# En PROD : https://padel.votre-domaine.com/auth/callback
KC_REDIRECT_URI=http://localhost:3000/auth/callback

SESSION_SECRET=generer_une_cle_secrete_aleatoire_ici
# COOKIE_SECURE=true # Décommenter en production (requis en HTTPS)
